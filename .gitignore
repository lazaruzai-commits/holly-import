.env
.venv/
__pycache__/
*.pyc
*.pyo
*.log

# Captured leads and chat transcripts — never commit
leads/*.csv
leads/*.jsonl

# Locally downloaded model imagery — large; fetched via scripts/fetch_images.py
static/img/models/*.jpg
static/img/models/*.jpeg
static/img/models/*.png
static/img/models/*.webp
!static/img/models/.gitkeep
# Exceptions: hand-processed cutouts that should NOT be auto-refreshed
!static/img/models/mg-rx9.jpg
!static/img/models/maxus-d90.jpg
!static/img/models/maxus-d90-ext-*.jpg
!static/img/models/maxus-d90-int-*.jpg
# Dealership-supplied transparent PNG renders for the MG lineup
!static/img/models/mg-3.png
!static/img/models/mg-3-hybrid.png
!static/img/models/mg-gt.png
!static/img/models/mg-zs.png
!static/img/models/mg-zs-ev.png
!static/img/models/mg-rx5.png
!static/img/models/mg-rx8.png
!static/img/models/mg-rx9.png
# Manifest is regenerated locally by the fetcher; tracking it just causes
# merge conflicts on every git pull
static/img/models/_manifest.json

# User-supplied raw photos waiting to be processed by scripts/process_local_images.py
# Originals never go to git — only the normalized output in static/img/models/
static/img/models/_source/*
!static/img/models/_source/.gitkeep

# Hero video and other marketing footage — large; fetched via scripts/fetch_video.py
static/video/*.mp4
static/video/*.webm

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
